generator client {
  provider = "prisma-client"
  output   = "./client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgres"
}

model Category {
  id  Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  deletedAt DateTime? 
  isDeleted Boolean @default(false)
  vocabulary Vocabulary[]
}

model Vocabulary {
  id Int @id @default(autoincrement())
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])
  word  String
  mean String
  example String? 
  createdAt DateTime @default(now())
  deletedAt DateTime?
}
